{
  "name": "mohammadhprp/filament-ip-to-country-flag-column",
  "description": "Display Country flag from IP address in your Filament tables",
  "keywords": [
    "mohammadhrpr",
    "laravel",
    "filament",
    "filament-ip-to-country-flag",
    "admin panel",
    "tables",
    "column"
  ],
  "homepage": "https://github.com/mohammadhprp/filament-ip-to-country-flag-column",
  "license": "MIT",
  "authors": [
    {
      "name": "Mohammadhprp",
      "email": "mohammadhprp@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "filament/tables": "^5.0"
  },
  "require-dev": {
    "laravel/pint": "^1.0",
    "orchestra/testbench": "^10.0",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Mohammadhprp\\IPToCountryFlagColumn\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Mohammadhprp\\IPToCountryFlagColumn\\IPToCountryFlagColumnServiceProvider"
      ]
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "test": "pest"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
